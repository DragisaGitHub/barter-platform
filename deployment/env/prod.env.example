# Copy to deployment/env/prod.env on the production host and fill real values there.
# Do not commit deployment/env/prod.env.
# Production must never run with the dev profile.

# Production should always pin immutable release tags or digests, never :latest.
# Git release refs may still be named v1.0.0, but runtime image tags should stay normalized.
BACKEND_IMAGE=dragisahub1984/barter-backend:1.0.0
FRONTEND_IMAGE=dragisahub1984/barter-frontend:1.0.0
CADDY_DOMAIN=barter-platform.example.com

POSTGRES_DB=barter_db
POSTGRES_USER=barter_user
POSTGRES_PASSWORD=replace-with-strong-postgres-password

DB_URL=jdbc:postgresql://postgres:5432/barter_db
DB_USERNAME=barter_user
DB_PASSWORD=replace-with-strong-postgres-password

SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseContainerSupport -XX:MaxMetaspaceSize=256m

# Required: long random secret, at least 32 characters/bytes.
# Examples:
#   openssl rand -base64 48
#   pwsh -NoProfile -Command "[Convert]::ToBase64String((1..48 | ForEach-Object { [byte](Get-Random -Minimum 0 -Maximum 256) }))"
JWT_SECRET=replace-with-long-random-production-secret
# Production-ready defaults: short-lived access token + revocable refresh token.
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Keep Swagger disabled publicly.
BARTER_SWAGGER_ENABLED=false

# Prefer same-origin /api/v1 proxying and leave this empty.
# If the frontend is hosted on a different origin, set a comma-separated HTTPS allowlist.
# Bearer-token auth does not require CORS credentials, so keep this false unless a future httpOnly-cookie flow is introduced.
BARTER_SECURITY_ALLOWED_ORIGINS=
BARTER_SECURITY_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
BARTER_SECURITY_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Correlation-Id,X-Request-Id,X-Requested-With
BARTER_SECURITY_EXPOSED_HEADERS=X-Correlation-Id
BARTER_SECURITY_ALLOW_CREDENTIALS=false
BARTER_SECURITY_CORS_MAX_AGE=1h
FRONTEND_ORIGIN=

# Vite build-time only. Runtime changes here do not alter an already-built frontend image.
# Default image build uses /api/v1 so nginx can proxy API calls to the internal backend container.
VITE_API_BASE_URL=/api/v1

# Frontend Sentry error tracking.
# Vite embeds these values at frontend Docker image build time.
# Runtime changes here do not affect an already-built frontend image.
# For PROD Docker Publish, configure GitHub Actions secret VITE_SENTRY_DSN_PROD.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=prod
VITE_COMMIT_SHA=

# Backend Sentry error tracking.
# Set to your project DSN to enable server-side error capture.
# Leave empty (or unset) to disable Sentry entirely for this environment.
# Missing DSN does not fail startup; Sentry is silently disabled.
SENTRY_DSN_BACKEND=

# Production registration/login should keep email verification enabled.
BARTER_EMAIL_VERIFICATION_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
MAIL_FROM=noreply@barter-platform.example.com

# Production item images should stay in Azure Blob Storage.
# Keep the container private; the backend serves images via /api/v1/files/**.
# Prefer the PROD-scoped names when managing separate env files per environment.
AZURE_STORAGE_CONNECTION_STRING_PROD=DefaultEndpointsProtocol=https;AccountName=replace;AccountKey=replace;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_PROD=item-images-prod
# Optional neutral aliases if you standardize on one shared variable name scheme.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=replace;AccountKey=replace;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=item-images-prod

# Keep production backups configured separately from DEV.
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_SCHEDULE=
BACKUP_LOCAL_RETENTION_COUNT=3
BACKUP_AZURE_CONTAINER=postgres-backups
BACKUP_AZURE_PREFIX=prod/postgres
BACKUP_WORK_DIR=
BACKUP_AZURE_CONNECTION_STRING=
POSTGRES_SERVICE=postgres

