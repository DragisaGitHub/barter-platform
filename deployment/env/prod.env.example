# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  Barter Platform — PRODUCTION Environment Variables                     ║
# ║                                                                          ║
# ║  Copy to: deployment/env/prod.env   (on the production host ONLY)        ║
# ║  NEVER commit deployment/env/prod.env to version control.                ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ─── Docker Image Tags ─────────────────────────────────────────────────────
# Production MUST pin immutable release tags or digests, never :latest.
# Update these to deploy a new release. Rollback = set previous tag + recreate.
BACKEND_IMAGE=dragisahub1984/barter-backend:1.0.0
FRONTEND_IMAGE=dragisahub1984/barter-frontend:1.0.0
LANDING_IMAGE=dragisahub1984/barter-landing:1.0.0

# ─── External Managed PostgreSQL ───────────────────────────────────────────
# Production does NOT run a local PostgreSQL container.
# Point to your managed instance (Azure Database for PostgreSQL, etc.).
# DB_URL format: jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_URL=jdbc:postgresql://your-server.postgres.database.azure.com:5432/barter_db?sslmode=require
DB_USERNAME=barter_user
# ⚠️  GENERATE SECURELY: openssl rand -base64 32
DB_PASSWORD=replace-with-strong-postgres-password

# ─── Spring Boot ───────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseContainerSupport -XX:MaxMetaspaceSize=256m

# ─── JWT Authentication ────────────────────────────────────────────────────
# ⚠️  GENERATE SECURELY: openssl rand -base64 48
JWT_SECRET=replace-with-long-random-production-secret
# Production-ready defaults: short-lived access token + revocable refresh token.
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# ─── Swagger / OpenAPI ─────────────────────────────────────────────────────
# Keep Swagger disabled publicly in production.
BARTER_SWAGGER_ENABLED=false

# ─── CORS / Security ──────────────────────────────────────────────────────
# Prefer same-origin /api/v1 proxying via Caddy — leave ALLOWED_ORIGINS empty.
# If the frontend is hosted on a different origin, set a comma-separated HTTPS allowlist.
BARTER_SECURITY_ALLOWED_ORIGINS=https://app.zameni.rs
BARTER_SECURITY_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
BARTER_SECURITY_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Correlation-Id,X-Request-Id,X-Requested-With
BARTER_SECURITY_EXPOSED_HEADERS=X-Correlation-Id
BARTER_SECURITY_ALLOW_CREDENTIALS=false
BARTER_SECURITY_CORS_MAX_AGE=1h
FRONTEND_ORIGIN=https://app.zameni.rs

# ─── Vite / Frontend Build-Time Variables ──────────────────────────────────
# These are baked into the frontend Docker image at build time.
# Runtime changes here do NOT alter an already-built frontend image.
VITE_API_BASE_URL=/api/v1

# ─── Sentry Error Tracking ────────────────────────────────────────────────
# Frontend Sentry — embedded at image build time via GitHub Actions secret.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=prod
VITE_COMMIT_SHA=

# ─── Landing Analytics (Build-Time Only) ──────────────────────────────────
# Google Analytics measurement ID — baked into the landing Docker image at
# build time via GitHub Actions secret VITE_GA_MEASUREMENT_ID.
# Runtime changes here do NOT alter an already-built landing image.
# Leave empty to keep analytics disabled.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend Sentry — set to your project DSN to enable server-side error capture.
# Leave empty to disable. Missing DSN does not fail startup.
SENTRY_DSN_BACKEND=

# ─── Email / SMTP ─────────────────────────────────────────────────────────
# Production MUST have email verification enabled with a real SMTP provider.
BARTER_EMAIL_VERIFICATION_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# ⚠️  Use credentials from your SMTP provider (Resend, Mailgun, SES, etc.)
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
MAIL_FROM=noreply@zameni.rs

# ─── Azure Blob Storage (Item Images) ─────────────────────────────────────
# Keep the container private; backend serves images via /api/v1/files/**.
# ⚠️  GENERATE: copy from Azure Portal > Storage Account > Access Keys
AZURE_STORAGE_CONNECTION_STRING_PROD=DefaultEndpointsProtocol=https;AccountName=replace;AccountKey=replace;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_PROD=item-images-prod

# ─── PostgreSQL Backups ────────────────────────────────────────────────────
# ⚠️  IMPORTANT: The included backup-db.sh script connects to a local postgres
# Docker container via `docker compose exec`. Production uses a MANAGED
# PostgreSQL instance — there is no local container to exec into.
# backup-db.sh is therefore NOT compatible with the default production setup.
#
# BACKUP_ENABLED must remain false until a managed-PostgreSQL backup strategy
# is implemented (e.g., using Azure Database for PostgreSQL built-in backups,
# a scheduled `pg_dump` over the managed connection string, or similar).
#
# The remaining variables are documented here as a reference for when a
# production backup solution is wired up.
BACKUP_ENABLED=false
# Frequency hint used by setup-backup-cron.sh to derive a cron schedule.
# Valid values: hourly, daily, weekly, monthly.
# Ignored while BACKUP_ENABLED=false.
BACKUP_FREQUENCY=daily
# Optional explicit cron expression (e.g. "0 3 * * *" for 03:00 UTC daily).
# Leave empty to derive the schedule automatically from BACKUP_FREQUENCY.
BACKUP_SCHEDULE=
BACKUP_LOCAL_RETENTION_COUNT=3
BACKUP_AZURE_CONTAINER=postgres-backups
BACKUP_AZURE_PREFIX=prod/postgres
# Leave empty to use the script default: <repo>/deployment/backups/postgres/
# Set an absolute path on the host (e.g. /var/backups/barter) if preferred.
BACKUP_WORK_DIR=
# ⚠️  May reuse the same storage account or a dedicated backup account.
BACKUP_AZURE_CONNECTION_STRING=
# Not applicable to the default production stack (no local PG container).
# Required by backup-db.sh only when a containerised postgres is present.
POSTGRES_SERVICE=

# ─── Bootstrap Admin (One-Time Setup) ─────────────────────────────────────
# ALL FOUR variables below are required to create the initial admin user.
# The backend checks BARTER_BOOTSTRAP_ADMIN_ENABLED first; if it is false (the
# default), the other three variables are never read and no admin is created.
#
# First deployment workflow:
#   1. Uncomment all four lines and fill in real values.
#   2. Deploy: bash deployment/scripts/deploy-prod.sh 1.0.0
#   3. Log in to https://app.zameni.rs with the admin credentials.
#   4. Comment out / remove all four lines from prod.env.
#   5. Recreate the backend to clear the secrets from the running container:
#        docker compose -f deployment/compose/docker-compose.prod.yml \
#          --env-file deployment/env/prod.env up -d --no-deps --force-recreate backend
#   The admin account persists in the database after step 5.
#
# ⚠️  GENERATE PASSWORD SECURELY: openssl rand -base64 24
# BARTER_BOOTSTRAP_ADMIN_ENABLED=true
# BARTER_BOOTSTRAP_ADMIN_USERNAME=admin
# BARTER_BOOTSTRAP_ADMIN_EMAIL=admin@zameni.rs
# BARTER_BOOTSTRAP_ADMIN_PASSWORD=replace-with-secure-admin-password

# ─── Demo/Business Content Seeding ────────────────────────────────────────
# Controls whether demo categories, tags, and sample content are inserted at startup.
# MUST remain false in production — admins create all catalog content manually.
# Default: false (safe for production)
BARTER_SEED_DEMO_CONTENT=false

