# Copy to deployment/env/dev.env on the DEV server and fill real values there.
# Do not commit deployment/env/dev.env.

# Optional image overrides. Defaults are shown here for clarity.
BACKEND_IMAGE=dragisahub1984/barter-backend:latest
FRONTEND_IMAGE=dragisahub1984/barter-frontend:latest

# Public DEV hostname. Caddy uses this to request and renew Let's Encrypt
# certificates automatically. DNS must point this host to the DEV VM public IP.
CADDY_DOMAIN=barter-platform-dev.duckdns.org

# PostgreSQL container initialization.
POSTGRES_DB=barter_db
POSTGRES_USER=barter_user
POSTGRES_PASSWORD=change-me-postgres-password

# Spring datasource. Keep host as "postgres" for the Compose service network.
DB_URL=jdbc:postgresql://postgres:5432/barter_db
DB_USERNAME=barter_user
DB_PASSWORD=change-me-postgres-password

# Spring profile and JVM sizing for a small OCI Always Free VM.
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xms128m -Xmx384m -XX:+UseContainerSupport -XX:MaxMetaspaceSize=160m

# Use a long random value, at least 32 characters/bytes.
# Examples:
#   openssl rand -base64 48
#   pwsh -NoProfile -Command "[Convert]::ToBase64String((1..48 | ForEach-Object { [byte](Get-Random -Minimum 0 -Maximum 256) }))"
JWT_SECRET=replace-with-long-random-dev-secret-at-least-32-bytes
# DEV defaults are intentionally a bit more relaxed than PROD for easier manual testing.
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=14

# Azure Blob Storage for DEV item images.
# Keep the container private; the backend serves images via /api/v1/files/**.
# Legacy DEV-specific names stay supported and are the current DEV default.
AZURE_STORAGE_CONNECTION_STRING_DEV=DefaultEndpointsProtocol=https;AccountName=replace;AccountKey=replace;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_DEV=item-images-dev
# Optional neutral aliases if you want the same variable names across environments.
# If you set these instead of the DEV-specific names, the backend will still resolve them.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=replace;AccountKey=replace;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=item-images-dev

# PostgreSQL backups.
# Item images already live in Azure Blob Storage and are not backed up locally by the DB backup job.
# BACKUP_AZURE_CONNECTION_STRING may reuse the same storage account connection string or point to a dedicated backup account.
BACKUP_ENABLED=true
BACKUP_FREQUENCY=monthly
# Optional explicit cron expression. Leave empty to derive from BACKUP_FREQUENCY.
BACKUP_SCHEDULE=
BACKUP_LOCAL_RETENTION_COUNT=2
BACKUP_AZURE_CONTAINER=postgres-backups
BACKUP_AZURE_PREFIX=dev/postgres
# Leave empty to use the script default: <repo>/deployment/backups/postgres
# or set an absolute path on the server.
BACKUP_WORK_DIR=
BACKUP_AZURE_CONNECTION_STRING=
POSTGRES_SERVICE=postgres

# SMTP. Leave SMTP_HOST empty to use the backend logging/fallback mail sender if supported.
# DEV disables email verification by default through application-dev.yml so new users can login immediately.
# Keep this true in production and configure SMTP/Resend with a verified sender domain there.
BARTER_EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@barter-platform.dev

# Frontend public origin / CORS note.
# The current deployment uses Caddy/nginx same-origin proxying for /api/v1, so browser CORS is avoided.
# Leave BARTER_SECURITY_ALLOWED_ORIGINS empty for same-origin deployments.
# If you run a separate browser origin against the backend directly, set an explicit allowlist.
# FRONTEND_ORIGIN remains as a backward-compatible single-origin alias.
BARTER_SECURITY_ALLOWED_ORIGINS=
FRONTEND_ORIGIN=https://barter-platform-dev.duckdns.org

# Vite build-time only. Runtime changes here do not alter an already-built frontend image.
# Default image build uses /api/v1 so nginx can proxy API calls to the internal backend container.
VITE_API_BASE_URL=/api/v1

